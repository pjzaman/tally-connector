TALLY_API_URL=https://us-central1-ape-erp-508ee.cloudfunctions.net/tallyApi
TALLY_URL=http://127.0.0.1:9000
COMPANY_GUID=replace-with-company-guid
COMPANY_NAME=replace-with-company-name
# Optional fallback if Tally's Company export does not return BooksFrom.
COMPANY_BOOKS_FROM=YYYY-MM-DD
# Optional: earliest voucher date watched for changes (defaults to BooksFrom, else 2000-01-01).
# This only widens what is watched; it never re-imports old vouchers.
VOUCHER_PERIOD_FROM=
POLL_SECONDS=45
REQUEST_RESULT_PART_BYTES=2000000
REQUEST_TIMEOUT_MS=30000
ENABLE_QUERY_QUEUE=false
ENABLE_DATA_SYNC=false
ENABLE_DELETION_SWEEPS=false
