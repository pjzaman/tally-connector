TALLY_API_URL=https://us-central1-ape-erp-508ee.cloudfunctions.net/tallyApi
TALLY_URL=http://127.0.0.1:9000
# Mirrors every company loaded in TallyPrime, each under its own company GUID.
# The owner's voucher start-date rule is 2026-01-01; set a later date only if required.
VOUCHER_PERIOD_FROM=2026-01-01
POLL_SECONDS=45
REQUEST_RESULT_PART_BYTES=2000000
REQUEST_TIMEOUT_MS=30000
TALLY_TIMEOUT_MS=120000
ENABLE_QUERY_QUEUE=false
ENABLE_DATA_SYNC=false
ENABLE_DELETION_SWEEPS=false
